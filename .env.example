# Samanvay-AI Environment Configuration
# Copy this to .env and adjust for your deployment

# ── PostgreSQL 16 ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=samanvay
POSTGRES_PASSWORD=samanvay_secure
POSTGRES_DB=samanvay_db

# ── Qdrant Vector Database ───────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Neo4j Graph Database ────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=samanvay_graph

# ── Application ─────────────────────────────────────
DEBUG=false
