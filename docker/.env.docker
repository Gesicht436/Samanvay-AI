# ==============================================================================
# Samanvay-AI: Docker Environment Configuration
# Project: Samanvay-AI | Version: 2.0.0-PROD
# ==============================================================================

# Application Metadata
APP_NAME=Samanvay-AI
APP_VERSION=2.0.0-PROD
APP_ENV=production
DEBUG=false

# PostgreSQL 16
POSTGRES_HOST=samanvay-ai-postgres
POSTGRES_PORT=5432
POSTGRES_USER=samanvay
POSTGRES_PASSWORD=samanvay_secure
POSTGRES_DB=samanvay_db

# Qdrant Vector Engine
QDRANT_HOST=samanvay-ai-qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=samanvay_inventory

# Neo4j Graph Database
NEO4J_URI=bolt://samanvay-ai-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=samanvay_graph

# Frontend API Binding
NEXT_PUBLIC_API_URL=http://localhost:8000
