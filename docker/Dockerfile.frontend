# ==============================================================================
# Samanvay-AI: Sovereign Web Portal & Executive Command Center
# Project: Samanvay-AI | Version: 2.0.0-PROD
# Organization: Ministry of Petroleum & Natural Gas (MoPNG) / BharatCodex
# ==============================================================================

# Stage 1: Dependency Caching
FROM node:22-alpine AS deps

LABEL maintainer="BharatCodex Team <samanvay-ai@mopng.gov.in>"
LABEL org.opencontainers.image.title="Samanvay-AI Frontend Dependencies"
LABEL project="Samanvay-AI"

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

# Stage 2: Next.js Production Build
FROM node:22-alpine AS builder

LABEL maintainer="BharatCodex Team <samanvay-ai@mopng.gov.in>"
LABEL org.opencontainers.image.title="Samanvay-AI Frontend Builder"
LABEL project="Samanvay-AI"

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN mkdir -p /app/public

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

# Stage 3: Minimal Production Runner
FROM node:22-alpine AS runner

LABEL maintainer="BharatCodex Team <samanvay-ai@mopng.gov.in>"
LABEL org.opencontainers.image.title="Samanvay-AI Web Portal"
LABEL org.opencontainers.image.description="Industrial Web Portal & Command Center for MoPNG CPSEs"
LABEL org.opencontainers.image.version="2.0.0-PROD"
LABEL org.opencontainers.image.vendor="MoPNG / BharatCodex"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL project="Samanvay-AI"

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

RUN apk add --no-cache wget

# Create unprivileged runtime user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy runtime assets and production build output
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://localhost:3000/ || exit 1

CMD ["npm", "run", "start"]
