# ==============================================================================
# Samanvay-AI: Industrial Web Portal & Executive Command Center
# Build context: project root (one level above docker/)
# Requires: next.config.ts output: 'standalone'
# ==============================================================================

# ── Stage 1: Dependency cache ─────────────────────────────────────────────────
FROM node:22-alpine AS deps

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# ── Stage 2: Next.js production build ────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    INTERNAL_BACKEND_URL=http://samanvay-ai-backend:8000 \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN npm run build

# ── Stage 3: Minimal standalone runtime (~80MB) ───────────────────────────────
FROM node:22-alpine AS runner

LABEL maintainer="BharatCodex Team <samanvay-ai@mopng.gov.in>"
LABEL org.opencontainers.image.title="Samanvay-AI Web Portal"
LABEL org.opencontainers.image.description="Industrial Web Portal & Command Center for MoPNG CPSEs"
LABEL org.opencontainers.image.version="2.0.0-PROD"
LABEL org.opencontainers.image.vendor="MoPNG / BharatCodex"
LABEL project="Samanvay-AI"

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    INTERNAL_BACKEND_URL=http://samanvay-ai-backend:8000 \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

RUN apk add --no-cache wget

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# Standalone output contains its own minimal node server — no node_modules needed
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://localhost:3000/ || exit 1

# standalone output emits server.js at the root
CMD ["node", "server.js"]
